# Kopieer naar .env en pas aan.

# Sleutel voor het ondertekenen van sessiecookies. Zet een lange, willekeurige
# waarde in productie (bijv. `python -c "import secrets; print(secrets.token_hex(32))"`).
SECRET_KEY=verander-mij-in-productie

# Gedeelde API-sleutel voor de REST-API (gebruikt door Bitfocus Companion en
# scripts). Stuur mee in de header `X-API-Key`. Leeg laten = API alleen via
# een ingelogde sessie bereikbaar.
ONAIR_API_KEY=verander-deze-sleutel

# Poort waarop de server luistert.
PORT=8080
