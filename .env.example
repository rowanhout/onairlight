# Kopieer naar .env en pas aan.

# Sleutel voor het ondertekenen van sessiecookies. Zet een lange, willekeurige
# waarde in productie (bijv. `python -c "import secrets; print(secrets.token_hex(32))"`).
SECRET_KEY=verander-mij-in-productie

# Gedeelde API-sleutel voor de REST-API (gebruikt door Bitfocus Companion en
# scripts). Stuur mee in de header `X-API-Key`. Leeg laten = API alleen via
# een ingelogde sessie bereikbaar.
ONAIR_API_KEY=verander-deze-sleutel

# Gedeelde token die elke ESP32-lamp moet meesturen om te mogen verbinden met
# /ws/device (zie firmware/onair-esp32/config.h.example -> DEVICE_TOKEN).
# Verplicht: zonder deze token weigert de server ALLE lamp-verbindingen, dit
# voorkomt dat een onbekende client zich als lamp kan voordoen en de fysieke
# on-air-verlichting kan overnemen.
ONAIR_DEVICE_TOKEN=verander-mij-in-een-lang-random-geheim

# Poort waarop de server luistert. (In de cloud, bv. Railway, wordt deze
# automatisch gezet — daar hoef je PORT niet op te geven.)
PORT=8080

# --- Alleen nodig voor een cloud-deploy (bijv. Railway) ---------------------

# Map waarin users.json en lamps.json worden bewaard. Laat leeg om naast de
# code op te slaan (lokaal). In de cloud: wijs naar een persistent volume,
# anders zijn je gebruikers/lampen na elke redeploy weg.
# ONAIR_DATA_DIR=/data

# Eenmalige admin die bij de eerste start wordt aangemaakt als hij nog niet
# bestaat. Handig in de cloud omdat je daar geen interactieve shell hebt voor
# create_user.py. Verwijder/leeg laten zodra de gebruiker bestaat.
# ONAIR_ADMIN_USER=rowan
# ONAIR_ADMIN_PASSWORD=verander-dit-wachtwoord
# ONAIR_ADMIN_NAAM=Rowan
