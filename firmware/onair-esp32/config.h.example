// ============================================================================
// config.h  --  Configuratie voor de On-Air Lamp ESP32-firmware
// ============================================================================
//
// Kopieer dit bestand naar "config.h" en vul de waarden hieronder in.
//   cp config.h.example config.h
//
// config.h staat (idealiter) in .gitignore zodat je per lamp eigen instellingen
// kunt zetten zonder ze te committen.
// ----------------------------------------------------------------------------

#pragma once

// ---------------------------------------------------------------------------
// 1) BOARD-KEUZE
// ---------------------------------------------------------------------------
// Kies welk bord je gebruikt. De firmware leidt hieruit automatisch de juiste
// Ethernet (RMII/LAN8710-LAN8720)-pinnen en de standaard lamp-GPIO af.
//
//   BOARD_OLIMEX_POE2    = 3   -> Olimex ESP32-POE2   (standaard, in gebruik)
//   BOARD_OLIMEX_POE_ISO = 1   -> Olimex ESP32-POE-ISO
//   BOARD_WT32_ETH01     = 2   -> WT32-ETH01
//
#define BOARD_OLIMEX_POE_ISO 1
#define BOARD_WT32_ETH01     2
#define BOARD_OLIMEX_POE2    3

#define BOARD BOARD_OLIMEX_POE2

// ---------------------------------------------------------------------------
// 2) SERVER
// ---------------------------------------------------------------------------
// De centrale FastAPI-server waarmee de lamp als WebSocket-CLIENT verbindt.
//
//  CLOUD via HTTPS (aanbevolen): de gewone route over poort 443, versleuteld
//                   en met een gevalideerd certificaat.
//                       SERVER_HOST = "reclamp.madera.video"
//                       SERVER_PORT = 443
//                       USE_TLS     = true        // -> wss://
//
//  LOKAAL (LAN):    de server draait op je eigen netwerk zonder TLS. Geen
//                   internet, geen DNS, geen certificaten en geen klok nodig --
//                   de robuustste route die er is, zie 2b.
//                       SERVER_HOST = "192.168.1.50"
//                       SERVER_PORT = 8080
//                       USE_TLS     = false       // -> ws://
//
// Bij wss (USE_TLS = true) wordt het servercertificaat gevalideerd tegen de
// root-certificaten in certs.h.
//
// LET OP bij "start_ssl_client: -1" of een handshake die niets teruggeeft:
// dat is meestal GEEN certificaat- of netwerkprobleem. Op dit bord bleek het
// de linksnelheid te zijn -- zie 4b. Op 100 Mbit sneuvelen volle frames, en de
// certificaatketen van de server is nu juist het eerste dat er een paar nodig
// heeft. Controleer dus eerst of de link op 10 Mbps staat voordat je aan
// certificaten, poorten of firewalls gaat sleutelen.
//
#define SERVER_HOST "192.168.1.50"   // hostnaam of IP van de server
#define SERVER_PORT 8080             // 443 voor wss/cloud, 8080 voor ws/lokaal
#define USE_TLS     false            // true = wss:// (cloud), false = ws:// (LAN)

// ---------------------------------------------------------------------------
// 2b) RESERVESERVER (optioneel, maar aan te raden)
// ---------------------------------------------------------------------------
// Een on-air lamp die alleen werkt als het internet het doet, kan tijdens een
// uitzending uitvallen. Geef daarom hierboven een server op het EIGEN netwerk
// op (geen internet, DNS of certificaten nodig -- dus niets dat kapot kan) en
// hieronder de cloud als reserve.
//
// Lukt de een FAILOVER_MS lang niet, dan probeert de lamp de ander, en zo door.
// Laat je dit blok uitgecommentarieerd, dan blijft de lamp eindeloos op de
// server hierboven proberen -- precies zoals voorheen.
//
// #define SERVER2_HOST "web-production-a09cb.up.railway.app"
// #define SERVER2_PORT 443
// #define SERVER2_TLS  true
//
// Hoe lang een bestemming de kans krijgt voordat de andere aan de beurt is:
// #define FAILOVER_MS 30000

// ---------------------------------------------------------------------------
// 3) IDENTITEIT VAN DEZE LAMP
// ---------------------------------------------------------------------------
// Deze waarden worden als URL-geencodeerde query-parameters meegestuurd:
//   /ws/device?id=<LAMP_ID>&naam=<LAMP_NAAM>&ruimte=<LAMP_RUIMTE>
// LAMP_ID moet UNIEK zijn per lamp (de server gebruikt dit als sleutel).
//
#define LAMP_ID     "studio-1"
#define LAMP_NAAM   "Studio 1"
#define LAMP_RUIMTE "Studio 1"

// ---------------------------------------------------------------------------
// 4) LAMP-GPIO
// ---------------------------------------------------------------------------
// GPIO die via een 220R gate-weerstand de MOSFET (IRLZ44N) aanstuurt.
// Active-HIGH: GPIO HIGH = lamp AAN (ON AIR), GPIO LOW = lamp UIT.
//
//   -1  = gebruik de standaard-GPIO van het gekozen bord:
//           Olimex ESP32-POE2    -> GPIO 4
//           Olimex ESP32-POE-ISO -> GPIO 32
//           WT32-ETH01           -> GPIO 4
//   >=0 = forceer een specifieke GPIO (overschrijft de board-default).
//
// BEZET op de Olimex ESP32-POE2 (WROVER) -- hier NOOIT de lamp op aansluiten:
//   GPIO 0                 -> Ethernet-klok
//   GPIO 12                -> Ethernet PHY power
//   GPIO 16, 17            -> PSRAM van de WROVER-module
//   GPIO 18, 19, 21-23, 25-27 -> Ethernet (RMII/MDIO)
//   GPIO 1                 -> seriele poort / programmeren
//   GPIO 2, 14, 15         -> microSD (vrij als je geen SD-kaart gebruikt)
//   GPIO 34-39             -> alleen ingang, kan niet schakelen
//
// VRIJ en geschikt als uitgang: GPIO 4 (standaard), 13, 33, en 5.
// LET OP: GPIO 20 bestaat NIET op dit bord (de WROVER-module heeft die pin niet).
//
#define LAMP_PIN -1

// ---------------------------------------------------------------------------
// 4b) LINKSNELHEID: 10 Mbit afdwingen
// ---------------------------------------------------------------------------
// Sommige exemplaren van de ESP32-POE2 halen 100 Mbit niet betrouwbaar: het
// RMII-signaal is dan niet schoon genoeg en frames met een bitfout worden door
// de hardware-checksumcontrole geruisloos weggegooid. Kleine pakketjes (DNS,
// NTP, het opzetten van een verbinding) komen wel door, dus het LIJKT te
// werken -- maar alles wat een volle frame nodig heeft (een TLS-handshake, een
// webpagina) komt nooit aan, zonder ook maar een foutmelding.
//
// De oplossing is de switchpoort op 10 Mbps full duplex zetten. Voor deze
// toepassing kost dat niets: een lamp stuurt een paar berichtjes per uur.
//
// Zet hieronder de bewaking aan. De firmware waarschuwt dan luid in de seriele
// monitor zodra de link toch op 100 Mbit staat -- bijvoorbeeld nadat iemand de
// kabel in een andere poort heeft gestoken.
//
// #define VEREIS_10MBIT 1

// ---------------------------------------------------------------------------
// 5) HEARTBEAT
// ---------------------------------------------------------------------------
// Interval (in milliseconden) waarmee de lamp een {"type":"ping"} stuurt zodat
// de server de verbinding als "online" blijft zien.
//
#define HEARTBEAT_MS 15000

// ---------------------------------------------------------------------------
// 6) OPTIONELE HOSTNAAM
// ---------------------------------------------------------------------------
// Haal het commentaar weg om een vaste netwerk-hostnaam te zetten (handig om de
// lamp in je router/DHCP terug te vinden).
//
// #define LAMP_HOSTNAME "onair-studio-1"

// ---------------------------------------------------------------------------
// 7) GEVORDERD: Ethernet-instellingen overrulen
// ---------------------------------------------------------------------------
// Normaal hoef je hier NIETS te doen: de firmware kiest de juiste PHY-pinnen
// op basis van BOARD hierboven.
//
// Komt Ethernet niet op (geen "[eth] IP-adres" in de seriele monitor, terwijl
// de kabel in een werkende switch zit)? Dan wijkt jouw board-revisie mogelijk
// af in de klok-modus. Haal dan een van deze regels uit commentaar en probeer
// opnieuw -- dit is verreweg de meest voorkomende afwijking:
//
// #define OA_CLK_MODE ETH_CLOCK_GPIO0_IN     // externe 50MHz oscillator
// #define OA_CLK_MODE ETH_CLOCK_GPIO0_OUT    // klok uit op GPIO0
// #define OA_CLK_MODE ETH_CLOCK_GPIO16_OUT   // klok uit op GPIO16
// #define OA_CLK_MODE ETH_CLOCK_GPIO17_OUT   // klok uit op GPIO17 (Olimex-standaard)
//
// De overige PHY-instellingen kun je op dezelfde manier forceren:
//
// #define OA_PHY_ADDR  0
// #define OA_PHY_POWER 12
// #define OA_PHY_MDC   23
// #define OA_PHY_MDIO  18

// ---------------------------------------------------------------------------
// 8) GEVORDERD: DNS-fallback
// ---------------------------------------------------------------------------
// Krijg je in de seriele monitor wel een IP-adres, maar meldingen als
//   hostByName(): DNS Failed for <jouw server>
// dan levert je DHCP-server geen bruikbare DNS mee. Zet er dan zelf een achter:
//
// #define DNS_FALLBACK "8.8.8.8"     // Google DNS
// #define DNS_FALLBACK "1.1.1.1"     // Cloudflare DNS
//
// De DNS-server van het netwerk zelf blijft gewoon de eerste keus; deze komt er
// alleen achter als reserve. Zo blijf je werken op netwerken die uitgaand
// DNS-verkeer naar buiten blokkeren -- daar is de DNS van de router juist de
// enige die het doet. De zelftest bij het opstarten laat zien welke gebruikt
// wordt en welk IP-adres eruit komt.

// ---------------------------------------------------------------------------
// 9) TIJD (NTP) -- alleen nodig bij USE_TLS = true
//    (gebruik je de TCP-proxy, dan wordt dit hele blok niet eens meegecompileerd)
// ---------------------------------------------------------------------------
// Voor wss:// wordt het servercertificaat gevalideerd, en daarvoor moet de klok
// van de ESP32 kloppen. De firmware haalt de tijd op via NTP.
//
// Blokkeert je netwerk NTP (UDP-poort 123)? Geen probleem: de firmware valt dan
// automatisch terug op de "Date"-header van een gewoon HTTP-antwoord van je
// eigen server. Je hoeft daar niets voor in te stellen.
//
// Heeft je router een eigen NTP-server (veel routers hebben dat), dan kun je
// die hier invullen -- dat werkt ook als internet-NTP geblokkeerd is:
//
#define NTP_SERVER_1 "pool.ntp.org"
#define NTP_SERVER_2 "time.cloudflare.com"
// #define NTP_SERVER_1 "192.168.2.1"     // bijv. het IP van je router

// ---------------------------------------------------------------------------
// 10) GEVORDERD: vast IP-adres in plaats van DHCP
// ---------------------------------------------------------------------------
// Blijft de lamp hangen op "[eth] wachten op netwerk (DHCP)..."? Dan geeft je
// netwerk geen lease. Zet dan hieronder een vast adres. Voor een vaste
// installatie is dat sowieso vaak netter dan DHCP.
//
// Kies een IP BUITEN de DHCP-pool van je router, maar in hetzelfde subnet.
// Alle vier de regels zijn nodig zodra je er een gebruikt.
//
// #define STATIC_IP      "192.168.1.60"
// #define STATIC_GATEWAY "192.168.1.1"      // meestal het IP van je router
// #define STATIC_SUBNET  "255.255.255.0"
// #define STATIC_DNS     "1.1.1.1"

// ---------------------------------------------------------------------------
// 11) DIAGNOSE: logging van de WebSocket-library
// ---------------------------------------------------------------------------
// Dit staat NIET hier, maar in platformio.ini: bouw met de omgeving poe2-debug
// om de interne meldingen van arduinoWebSockets te zien (verbinden, headers,
// TLS). Een #define in config.h heeft geen effect, want de library wordt als
// aparte vertaaleenheid gecompileerd en ziet die macro niet.
//
//   pio run -e poe2-debug -t upload && pio device monitor
//
// Zet het daarna weer terug naar 'pio run -t upload', want het maakt de
// seriele monitor erg spraakzaam.
//
// De firmware doet bij elke start sowieso al een korte netwerk-zelftest
// ([test] DNS / TCP / HTTP) die laat zien of de server bereikbaar is.
//
// BESLISSENDE METING bij verbindingsproblemen: laat het bord praten met een
// machine op HETZELFDE subnet. Dat verkeer gaat rechtstreeks over de switch --
// geen router, geen firewall, geen NAT, geen MTU-versmalling -- dus als dat
// ook niet lukt, ligt het aan het bord en niet aan het netwerk.
//
// Draai op die machine bijvoorbeeld:  python3 -m http.server 8000
// en zet hier zijn IP-adres:
//
// #define LOKALE_TEST_HOST "192.168.1.20"
// #define LOKALE_TEST_PORT 8000
//
// Blijkt daaruit dat de doelpoort dicht zit, dan kun je laten meten of TLS op
// poort 443 wel bruikbaar is. Zet daarvoor:
//
// #define TLS_TEST 1
//
// LET OP: alleen tijdens het uitzoeken, nooit in een lamp die in gebruik is.
// Op netwerken die TLS-verkeer opvangen en niet beantwoorden keert de
// handshake niet terug en blijft de lamp in de test hangen -- de timeout geldt
// voor het verbinden, niet voor het handshaken.
